# Optional backend settings. No API keys are required for local SPICE calculations.
CACHE_PATH=/workspace/nasa/data/cache.sqlite
# LOLA_MANIFEST=/absolute/path/to/lola-manifest.json
# Frontend: set before npm run build (Next.js rewrites are generated at build time).
BACKEND_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
# Optional Next.js runtime settings for Supabase authentication and saved searches.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SITE_URL=http://localhost:3000
